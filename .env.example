# Chạy npm run setup để tạo .env với secrets ngẫu nhiên. Không commit .env.
ADMIN_TOKEN=
JWT_SECRET=
PORT=3000
HOST_PORT=8080
COOKIE_SECURE=false
# Khôi phục mật khẩu qua email (không đưa API key vào mã nguồn).
PUBLIC_URL=http://localhost:8080
RESEND_API_KEY=
MAIL_FROM=
WEATHER_API_KEY=
# GHN vận chuyển: thông số kiện được ước tính theo sản phẩm trong từng đơn; có thể nhập số đo thực trong admin.
GHN_BASE_URL=https://online-gateway.ghn.vn
GHN_TOKEN=
GHN_SHOP_ID=
GHN_AUTO_CREATE_ORDERS=false
GHN_WEBHOOK_SECRET=
GHN_FROM_NAME=
GHN_FROM_PHONE=
GHN_FROM_ADDRESS=
GHN_FROM_PROVINCE=
GHN_FROM_WARD=
GHN_FROM_DISTRICT=
GHN_REQUIRED_NOTE=CHOXEMHANGKHONGTHU
# DOCKER_IMAGE=tenban/shop-online:latest
